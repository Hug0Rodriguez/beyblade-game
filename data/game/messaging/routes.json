{
  "//": "message type → ordered handler ids. Key order = delivery order within a drain pass; handler order = call order.",
  "KeyChanged": [
    "spinner.onKeyChanged"
  ],
  "JoystickMoved": [
    "spinner.onJoystickMoved"
  ],
  "TouchButtonChanged": [
    "spinner.onTouchButtonChanged"
  ],
  "PointerKindDetected": [
    "spinner.view.onPointerKind",
    "screens.title.onPointerKind",
    "screens.brawl.onPointerKind",
    "style.view.onPointerKind"
  ],
  "//input": "Device input is delivered before StepTicked so a step always sees this frame's input.",
  "StepTicked": [
    "flow.tick",
    "spinner.readHumanCommands",
    "spinner.decideCpuCommands",
    "moves.tickMoves",
    "dish.computeForces",
    "rig.tickSpin",
    "style.tickRev",
    "brawl.integrateMotion",
    "round.tick"
  ],
  "TimeScaleRequested": [
    "engine.time.onTimeScaleRequested"
  ],
  "GameBooted": [
    "spinner.onGameBooted",
    "flow.gameFlow"
  ],
  "StateEntered": [
    "engine.screens.onStateEntered",
    "spinner.onFlowState",
    "spinner.observeMoves",
    "dish.onFlowState",
    "rig.onFlowState",
    "moves.onFlowState",
    "brawl.onStateEntered",
    "style.onFlowState",
    "round.onFlowState",
    "match.onRoundSettled",
    "rig.view.onMoveState",
    "brawl.view.onFlowState",
    "screens.brawl.onFlowState",
    "spinner.view.onMoveState"
  ],
  "StateExited": [],
  "SpinnerAssigned": [
    "rig.onSpinnerAssigned",
    "match.onSpinnerAssigned",
    "rig.view.hudOnSpinnerAssigned",
    "match.view.onSpinnerAssigned",
    "style.view.onSpinnerAssigned",
    "spinner.view.onSpinnerAssigned"
  ],
  "RigReady": [
    "dish.onRigReady",
    "moves.onRigReady",
    "brawl.onRigReady",
    "style.onRigReady",
    "round.onRigReady",
    "rig.view.onRigReady",
    "rig.view.hudOnRigReady",
    "brawl.view.onRigReady"
  ],
  "StartRequested": [
    "match.onStartRequested"
  ],
  "RematchRequested": [
    "match.onRematchRequested"
  ],
  "TitleRequested": [
    "flow.gameFlow"
  ],
  "MatchStarted": [
    "round.onMatchStarted",
    "flow.gameFlow"
  ],
  "RoundStarted": [
    "rig.onRoundStarted",
    "brawl.onRoundStarted",
    "dish.onRoundStarted",
    "moves.onRoundStarted",
    "spinner.onRoundStarted",
    "style.onRoundStarted",
    "round.onRoundStarted",
    "rig.view.onRoundStarted",
    "brawl.view.onRoundStarted",
    "round.view.onRoundStarted",
    "style.view.onRoundStarted"
  ],
  "CountdownBeat": [
    "round.view.onCountdownBeat"
  ],
  "CountdownFinished": [
    "flow.gameFlow"
  ],
  "SpinnerCommandIssued": [
    "moves.applyCommand",
    "brawl.applySteer"
  ],
  "MoveStarted": [
    "rig.onMoveStarted",
    "brawl.onMoveStarted",
    "brawl.view.onMoveStarted",
    "rig.view.onMoveStarted",
    "style.onMoveStarted"
  ],
  "MoveRefused": [
    "rig.view.onMoveRefused"
  ],
  "RevCancelled": [
    "style.onRevCancelled"
  ],
