  ],
  "ShatterReady": [
    "moves.observeShatterReady",
    "spinner.observeShatterReady",
    "style.view.onShatterReady",
    "spinner.view.onShatterReady"
  ],
  "ShatterCharging": [
    "rig.view.onShatterCharging"
  ],
  "RoundFinished": [
    "match.awardPoints",
    "style.onRoundFinished",
    "rig.view.onRoundFinished",
    "brawl.view.onRoundFinished",
    "round.view.onRoundFinished"
  ],
  "PointsAwarded": [
    "match.view.onPointsAwarded"
  ],
  "RoundScored": [
    "flow.gameFlow"
  ],
  "MatchWon": [
    "flow.gameFlow",
    "screens.matchResult.onMatchWon"
  ],
  "ViewportResized": [
    "engine.screens.onViewportResized",
    "spinner.view.layout",
    "rig.view.layoutHud",
    "style.view.layout",
    "match.view.layout",
    "round.view.layout",
    "screens.title.layout",
    "screens.brawl.layout",
    "screens.matchResult.layout"
  ],
  "FrameRendered": [
    "rig.view.render",
    "brawl.view.render",
    "style.view.animate",
    "round.view.animate",
    "screens.title.animate"
  ]
